%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 493fc08a0e2d8d64da6a5b9239c277fb, type: 3}
  m_Name: Sakamoto
  m_EditorClassIdentifier: 
  nombreEntrevistado: Futaba
  preguntas:
  - preguntaEspanol: "Futaba te saluda. \xBFQu\xE9 le respondes?"
    preguntaJapones: "\u3053\u3093\u306B\u3061\u306F\uFF01 (Konnichiwa!)"
    opciones:
    - textoOpcion: "\u3053\u3093\u306B\u3061\u306F (konnichiwa)"
      respuestaDelNPC: "\xA1Qu\xE9 educado! T\xFA eres quien escribe para el bolet\xEDn,
        \xBFno?"
      esCorrecta: 1
      puntaje: 2
      reaccion: 0
    - textoOpcion: "\u3042\u308A\u304C\u3068\u3046 (arigat\u014D)"
      respuestaDelNPC: "\xBFGracias? Si todav\xEDa no hice nada..."
      esCorrecta: 0
      puntaje: 0
      reaccion: 2
    - textoOpcion: "\u3059\u307F\u307E\u305B\u3093 (sumimasen)"
      respuestaDelNPC: "No debes disculparte. \xA1Hola!"
      esCorrecta: 0
      puntaje: 1
      reaccion: 1
  - preguntaEspanol: "Acepta la entrevista. P\xEDdele empezar con cortes\xEDa."
    preguntaJapones: "\u30A4\u30F3\u30BF\u30D3\u30E5\u30FC\uFF1F \u3044\u3044\u3067\u3059\u3088\u3002(Intaby\u016B?
      Ii desu yo.)"
    opciones:
    - textoOpcion: "\u3059\u307F\u307E\u305B\u3093 (sumimasen)"
      respuestaDelNPC: "\xBFPor qu\xE9 te disculpas? Empecemos."
      esCorrecta: 0
      puntaje: 1
      reaccion: 1
    - textoOpcion: "\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B (irasshaimase)"
      respuestaDelNPC: "Eso lo dicen los empleados en las tiendas... \xA1Esto no
        es un konbini!"
      esCorrecta: 0
      puntaje: 0
      reaccion: 3
    - textoOpcion: "\u304A\u306D\u304C\u3044\u3057\u307E\u3059 (onegaishimasu)"
      respuestaDelNPC: "\xA1Claro! Pregunta lo que quieras."
      esCorrecta: 1
      puntaje: 2
      reaccion: 0
  - preguntaEspanol: "Te cuenta qu\xE9 vender\xE1 en el festival. \xBFQu\xE9 vender\xE1?"
    preguntaJapones: "\u307E\u3064\u308A\u3067 \u304A\u306B\u304E\u308A\u3068 \u304A\u3061\u3083\u3092
      \u3046\u308A\u307E\u3059\u3002(Matsuri de onigiri to ocha wo urimasu.)"
    opciones:
    - textoOpcion: "Bolas de arroz y t\xE9"
      respuestaDelNPC: "\xA1Exacto! Mis onigiri son los mejores del barrio."
      esCorrecta: 1
      puntaje: 2
      reaccion: 0
    - textoOpcion: Agua y arroz
      respuestaDelNPC: "Casi\u2026 \u304A\u3061\u3083 (ocha) es t\xE9, no agua."
      esCorrecta: 0
      puntaje: 1
      reaccion: 1
    - textoOpcion: "Caf\xE9 y revistas"
      respuestaDelNPC: "No, no\u2026 eso se compra en la konbini."
      esCorrecta: 0
      puntaje: 0
      reaccion: 2
  - preguntaEspanol: "Te dice el n\xFAmero de su puesto. \xBFCu\xE1l es?"
    preguntaJapones: "\u308F\u305F\u3057\u306E \u307F\u305B\u306F \u3055\u3093\u3070\u3093
      \u3067\u3059\u3002(Watashi no mise wa san-ban desu.)"
    opciones:
    - textoOpcion: Puesto 2
      respuestaDelNPC: "No, \u306B\u3070\u3093 (ni-ban) ser\xEDa el 2."
      esCorrecta: 0
      puntaje: 0
      reaccion: 1
    - textoOpcion: Puesto 3
      respuestaDelNPC: "\xA1Eso es! Te espero en el puesto 3."
      esCorrecta: 1
      puntaje: 2
      reaccion: 0
    - textoOpcion: Puesto 5
      respuestaDelNPC: "No, \u3054\u3070\u3093 (go-ban) ser\xEDa el 5."
      esCorrecta: 0
      puntaje: 0
      reaccion: 1
  - preguntaEspanol: "La entrevista termin\xF3. \xBFQu\xE9 le dices?"
    preguntaJapones: "\u3053\u308C\u3067 \u304A\u308F\u308A\u3067\u3059\u3002(Kore
      de owari desu.)"
    opciones:
    - textoOpcion: "\u304A\u306F\u3088\u3046\u3054\u3056\u3044\u307E\u3059 (ohay\u014D
        gozaimasu)"
      respuestaDelNPC: "\xBFBuenos d\xEDas? Ya nos saludamos hace rato\u2026"
      esCorrecta: 0
      puntaje: 0
      reaccion: 2
    - textoOpcion: "\u3054\u306F\u3093 (gohan)"
      respuestaDelNPC: "\xBFArroz? \xBFQuieres que te invite a comer?"
      esCorrecta: 0
      puntaje: 0
      reaccion: 1
    - textoOpcion: "\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059
        (arigat\u014D gozaimasu)"
      respuestaDelNPC: "\xA1Gracias a ti! Nos vemos en el festival."
      esCorrecta: 1
      puntaje: 2
      reaccion: 0
  puntajeMaximo: 10
  puntajeMinimoExito: 6
